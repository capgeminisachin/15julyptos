@Metadata.layer: #CUSTOMER

    @UI.headerInfo: {
  typeName: 'Document',
  typeNamePlural: 'Documents'
}

annotate entity ZC_Doc
    with 
{
  @UI.facet: [
    { id: 'General',    type: #IDENTIFICATION_REFERENCE, label: 'General',    position: 10 },
    { id: 'Attachment', type: #IDENTIFICATION_REFERENCE, label: 'Attachment', position: 20, targetQualifier: 'Attach' }
  ]

  @UI:{ lineItem: [{ position: 10 }],
        identification: [{ position: 10 }] }
  DocId;

  @UI:{ lineItem: [{ position: 20 }],
        identification: [{ position: 20 }] }
  DocTitle;

  @UI:{ identification: [{ position: 30, qualifier: 'Attach' }] }
  Attachment;

  @UI:{ identification: [{ position: 40, qualifier: 'Attach' }] }
  MimeType;

  @UI:{ identification: [{ position: 50, qualifier: 'Attach' }] }
  FileName;
}